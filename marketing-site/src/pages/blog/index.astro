---
import Base from '../../layouts/Base.astro';
import CTA from '../../components/CTA.astro';
import { blog } from '../../data/site';
---
<Base
  title="Blog — Two-Wheeler Care Tips"
  description="Guides and tips on two-wheeler maintenance, EV care and transparent servicing from Doorstep Bike Service."
>
  <section class="hero" style="padding:54px 0 60px">
    <div class="wrap">
      <span class="pill">Blog</span>
      <h1 style="font-size:38px">Two-wheeler care, explained</h1>
      <p class="sub">Practical maintenance guides for petrol bikes, scooters and EVs.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="grid c3">
        {blog.map((p) => (
          <a href={`/blog/${p.slug}/`} class="card hover">
            <span class="pill muted">{p.tag}</span>
            <h3 style="margin-top:12px">{p.title}</h3>
            <p style="margin-top:6px">{p.excerpt}</p>
            <div class="svc-meta" style="margin-top:12px">{p.date} · Read →</div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <CTA />
</Base>
