---
import Base from '../../layouts/Base.astro';
import CTA from '../../components/CTA.astro';
import FAQList from '../../components/FAQList.astro';
import { categories, faqs, services } from '../../data/site';

export function getStaticPaths() {
  return categories.map((c) => ({ params: { category: c.key }, props: { category: c } }));
}

const { category } = Astro.props;
const list = services.filter((s) => s.category === category.key);
const gst = (n: number) => Math.round(n * 1.18);
const priced = list.filter((s) => s.price !== null).map((s) => s.price as number);
const from = priced.length ? Math.min(...priced) : null;
---
<Base
  title={`${category.name} at Your Doorstep`}
  description={`${category.name}: ${category.blurb} Upfront pricing, certified mechanics and a workmanship warranty at your doorstep.`}
>
  <section class="hero" style="padding:54px 0 60px">
    <div class="wrap">
      <div class="breadcrumb"><a href="/services/">Services</a> / {category.name}</div>
      <span class="pill">{category.emoji} {category.name}</span>
      <h1 style="font-size:38px">{category.name} at your doorstep</h1>
      <p class="sub">{category.blurb}</p>
      {from !== null && <p style="color:#dfe6ef;font-weight:600">Starting ₹{gst(from).toLocaleString('en-IN')} incl. GST</p>}
      <div class="hero-cta"><a href="/contact/" class="btn primary">Book now</a></div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head"><h2 class="h2">Services & prices</h2></div>
      <div class="card">
        {list.map((s) => (
          <div class="svc-row">
            <div>
              <strong>{s.name}</strong>
              <div class="svc-meta">{s.summary} · {s.durationMin} min{s.points > 0 ? ` · ${s.points}-point` : ''}</div>
            </div>
            <div style="text-align:right">
              {s.price === null
                ? <span class="price" style="color:var(--primary-dark)">Get quote</span>
                : <div><div class="price">₹{gst(s.price).toLocaleString('en-IN')}</div><small style="color:var(--text-muted)">incl. GST</small></div>}
            </div>
          </div>
        ))}
      </div>
      <p class="note" style="margin-top:16px">Prices are upfront and include 18% GST. Any additional repair found during service is quoted and needs your explicit approval before work proceeds.</p>
    </div>
  </section>

  <section class="section alt">
    <div class="wrap" style="max-width:820px">
      <div class="section-head center"><h2 class="h2">Questions</h2></div>
      <FAQList items={faqs.slice(0, 4)} />
    </div>
  </section>

  <CTA title={`Book a ${category.name.toLowerCase()} today`} />
</Base>
