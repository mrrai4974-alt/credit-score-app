---
import Base from '../../layouts/Base.astro';
import CTA from '../../components/CTA.astro';
import { categories, excludedServices, services } from '../../data/site';

const gst = (n: number) => Math.round(n * 1.18);
---
<Base
  title="Bike Service Prices — Transparent, Upfront"
  description="Browse all doorstep two-wheeler services with upfront prices, duration and inspection points across EV, general, premium, Royal Enfield and special services."
>
  <section class="hero" style="padding:54px 0 60px">
    <div class="wrap">
      <span class="pill">Transparent pricing</span>
      <h1 style="font-size:38px">Service catalog & prices</h1>
      <p class="sub">Every service has an upfront price. Prices below exclude 18% GST; you approve any additional work before it happens.</p>
    </div>
  </section>

  {categories.map((cat) => {
    const list = services.filter((s) => s.category === cat.key);
    return (
      <section class="section" id={cat.key}>
        <div class="wrap">
          <div class="section-head">
            <span class="eyebrow">{cat.emoji} {cat.name}</span>
            <h2 class="h2">{cat.name}</h2>
            <p class="lead">{cat.blurb}</p>
          </div>
          <div class="card">
            {list.map((s) => (
              <div class="svc-row">
                <div>
                  <strong>{s.name}</strong>
                  <div class="svc-meta">{s.durationMin} min{s.points > 0 ? ` · ${s.points}-point inspection` : ''}</div>
                </div>
                <div style="text-align:right">
                  {s.price === null
                    ? <span class="price" style="color:var(--primary-dark)">Get quote</span>
                    : <div><div class="price">₹{gst(s.price).toLocaleString('en-IN')}</div><small style="color:var(--text-muted)">incl. GST</small></div>}
                </div>
              </div>
            ))}
          </div>
          <div style="margin-top:14px"><a href={`/services/${cat.key}/`} class="btn outline sm">More about {cat.name} →</a></div>
        </div>
      </section>
    );
  })}

  <section class="section alt">
    <div class="wrap" style="max-width:820px">
      <div class="note">
        <strong>Not offered at doorstep:</strong> {excludedServices.join(', ')} — excluded to protect service quality and turnaround.
      </div>
    </div>
  </section>

  <CTA />
</Base>
