---
import Base from '../../layouts/Base.astro';
import CTA from '../../components/CTA.astro';
import { brands, slugify } from '../../data/site';

const totalModels = brands.reduce((s, b) => s + b.models.length, 0);
---
<Base
  title="Bike Brands We Service — 45+ Brands"
  description="Doorstep service for 45+ two-wheeler brands and hundreds of models — Honda, Hero, TVS, Bajaj, Royal Enfield, Ather, Ola and more, petrol and EV."
>
  <section class="hero" style="padding:54px 0 60px">
    <div class="wrap">
      <span class="pill">Multi-brand · petrol + EV</span>
      <h1 style="font-size:38px">Brands we service</h1>
      <p class="sub">Certified, multi-brand mechanics for {brands.length}+ brands and {totalModels}+ models — from commuter scooters to premium and electric two-wheelers.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="grid c3">
        {brands.map((b) => (
          <a href={`/brands/${slugify(b.name)}/`} class="card hover">
            <div style="display:flex;justify-content:space-between;align-items:center">
              <h3 style="margin:0">{b.name}</h3>
              <span class="pill muted">{b.type}</span>
            </div>
            <p style="margin-top:8px">{b.models.slice(0, 4).join(' · ')}{b.models.length > 4 ? ' …' : ''}</p>
            <div style="margin-top:12px" class="pill">{b.models.length} models →</div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <CTA />
</Base>
