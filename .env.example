# ---------------------------------------------------------------------------
# Credit bureau configuration
# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values to connect a live bureau.
# With no values set, the app uses the built-in mock bureau (realistic demo
# data, no backend required).
#
# These are read by app.config.js and exposed to the app via expo-constants
# (see src/config/env.ts). Reload Expo after changing them.

# Which bureau to talk to: mock | cibil | experian | equifax | crif
BUREAU_PROVIDER=mock

# Base URL of YOUR backend that proxies the bureau call (recommended), or the
# bureau's sandbox URL directly. The app POSTs to `${BUREAU_BASE_URL}/credit/report`.
BUREAU_BASE_URL=

# API key/token. STRONGLY prefer keeping bureau credentials on your backend and
# leaving this blank — never ship a real bureau key inside a mobile bundle.
BUREAU_API_KEY=
