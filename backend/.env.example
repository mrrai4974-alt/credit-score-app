# Copy to .env to override defaults

PORT=4000
JWT_SECRET=dev-secret-change-me

# Fixed OTP accepted in dev (in addition to any 6-digit code)
DEV_OTP=123456

# Postgres connection (defaults to the local dev database)
DATABASE_URL=postgresql://doorstep:doorstep@localhost:5432/doorstep

# Razorpay — set both to enable live payments. If unset, the API runs in
# "mock mode": orders are stubbed and verification is accepted, so the payment
# flow is demonstrable without credentials.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
