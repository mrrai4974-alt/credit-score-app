# ---------------------------------------------------------------------------
# Voice AI Agent — environment variables
#
# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env.local`. NEVER put secret keys in NEXT_PUBLIC_* variables —
# anything prefixed with NEXT_PUBLIC_ is shipped to the browser.
# ---------------------------------------------------------------------------

# --- AI provider (server-side only) ---
# Which AI to use: "groq" (FREE) or "claude" (paid). If left blank, the app
# auto-picks: Groq when GROQ_API_KEY is set, otherwise Claude.
AI_PROVIDER=

# Option A — Groq (FREE, no credit card). Recommended to start.
# Get a free key at https://console.groq.com  (API Keys -> Create)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Option B — Claude (paid). Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
# claude-opus-5 (smartest) | claude-sonnet-5 | claude-haiku-4-5 (cheapest)
CLAUDE_MODEL=claude-opus-5

# --- Speech-to-Text provider (server-side, optional — added in later phases) ---
# Provider one of: browser | whisper | google | deepgram
STT_PROVIDER=browser
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
GOOGLE_STT_API_KEY=

# --- Text-to-Speech provider (server-side, optional — added in later phases) ---
# Provider one of: browser | elevenlabs | openai | google
TTS_PROVIDER=browser
ELEVENLABS_API_KEY=
GOOGLE_TTS_API_KEY=

# --- Database (added in Phase 8) ---
DATABASE_URL=

# --- Auth.js (added in Phase 8) ---
AUTH_SECRET=
